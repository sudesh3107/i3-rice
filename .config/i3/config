set $mod Mod4
set $term st
set $browser "flatpak run org.qutebrowser.qutebrowser"
set $music "st -e termusic"

font pango:Hack Nerd Font Mono 10

default_border pixel 1
default_floating_border pixel 1

# BreadOnPenguins echo colorscheme (pywal-managed block, do not edit)
# wal-begin
set $bg #30272b
set $border #443c40
set $fg #F38B58
set $selfg #30272b
set $selborder #443c40
set $selbg #F38B58
set $urgent #DBB77E
# wal-end

client.focused          $selborder $selbg $selfg $selborder $bg
client.focused_inactive $border $border $fg $border $bg
client.unfocused        $bg $bg $fg $bg $bg
client.urgent           $urgent $urgent $bg $urgent $bg

# gaps (dwm vanitygaps: gappoh 20, gappov 30)
gaps inner 10
gaps top 30
gaps bottom 30
gaps left 20
gaps right 20

floating_modifier $mod
workspace_layout default
focus_follows_mouse no

# dwm-style launcher + terminal
bindsym $mod+d exec "dmenu_run -fn 'Hack Nerd Font Mono-10' -nb '$bg' -nf '$fg' -sb '$selbg' -sf '$selfg'"
bindsym $mod+Return exec $term
bindsym $mod+Shift+b bar mode toggle

# focus / move (dwm STACKKEYS: j/k)
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up

# master area resize (dwm setmfact h/l)
bindsym $mod+h resize shrink width 5 px or 5 ppt
bindsym $mod+l resize grow width 5 px or 5 ppt

# workspaces (dwm TAGKEYS)
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10

bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10

bindsym $mod+Tab workspace back_and_forth

# layouts
bindsym $mod+t layout toggle split
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+m layout tabbed
bindsym $mod+s layout stacking
bindsym $mod+space move position center
bindsym $mod+Control+space focus parent
bindsym $mod+Shift+space floating toggle

# quit / restart (dwm: mod+shift+backspace quit, mod+ctrl+shift+q restart)
bindsym $mod+Control+Shift+q restart
bindsym $mod+Shift+BackSpace exec "i3-nagbar -t warning -m 'Exit i3?' -B 'Yes' 'i3-msg exit'"

# kill (dwm: mod+q kill, mod+shift+q kill all others)
bindsym $mod+q kill
bindsym $mod+Shift+q exec killothers

# gaps control (dwm incrgaps)
bindsym $mod+minus gaps inner all minus 3
bindsym $mod+equal gaps inner all plus 3
bindsym $mod+Shift+minus gaps inner all 10
bindsym $mod+Shift+equal gaps inner all 0

# application bindings
bindsym $mod+w exec $browser
bindsym $mod+m exec $music
bindsym $mod+Shift+f exec pcmanfm
bindsym $mod+n exec st -e nvim
bindsym $mod+Shift+h exec st -e htop
bindsym $mod+p exec flatpak run org.darktable.Darktable

# script launch bindings
bindsym $mod+Shift+w exec wallpapermenu
bindsym $mod+F1 exec flameshot gui
bindsym $mod+Shift+F1 exec "flameshot full -p ~/Pictures/Screenshots"

# media keys
bindsym XF86AudioRaiseVolume exec amixer -D pulse sset Master 5%+
bindsym XF86AudioLowerVolume exec amixer -D pulse sset Master 5%-
bindsym XF86AudioMute exec amixer -D pulse sset Master toggle
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous
bindsym $mod+F5 exec amixer -D pulse sset Master 5%-
bindsym $mod+F6 exec amixer -D pulse sset Master 5%+
bindsym $mod+F8 exec i3lock
bindsym $mod+F10 exec playerctl previous
bindsym $mod+F11 exec playerctl play-pause
bindsym $mod+F12 exec playerctl next

# mouse: dwm-style resize/move + gaps on scroll
bindsym --release $mod+Button4 gaps inner all plus 3
bindsym --release $mod+Button5 gaps inner all minus 3

mode "resize" {
    bindsym h resize shrink width 10 px
    bindsym j resize shrink height 10 px
    bindsym k resize grow height 10 px
    bindsym l resize grow width 10 px
    bindsym Escape mode "default"
    bindsym Return mode "default"
}

# autostart
exec --no-startup-id picom -b
exec --no-startup-id dunst
exec --no-startup-id xss-lock -- i3lock
exec --no-startup-id feh --bg-fill "$HOME/Pictures/wallpapers/squarebw.png"

bar {
    font pango:Hack Nerd Font Mono 10
    position top
    separator_symbol "|"
    status_command i3status-rs
    colors {
        background $bg
        statusline $fg
        focused_workspace  $selborder $selbg $selfg
        active_workspace   $border $border $fg
        inactive_workspace $border $border $fg
        urgent_workspace   $urgent $urgent $bg
    }
}